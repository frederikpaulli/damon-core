{
  "name": "damon-core",
  "version": "0.1.0",
  "description": "Core of Damon, a desktop app where a manager model splits work into jobs for AI agents and reviews what comes back",
  "author": "Frederik Paulli",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json",
    "test": "vitest run --maxWorkers=2",
    "preview": "vite --config vite.preview.config.ts",
    "build:preview": "vite build --config vite.preview.config.ts",
    "preview:serve": "vite preview --config vite.preview.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.14"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
